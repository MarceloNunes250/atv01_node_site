   <%- include ('partials/header.ejs') %>
  <%- include ('partials/navbar.ejs') %>
         <link rel="stylesheet" href="./css/banda.css">
<!-- Conteúdo Principal -->
    <main>
        <div class="header-pagina">
            <h1>A Banda</h1>
            <p>Acompanhe a trajetória e os momentos marcantes da história dos Beatles.</p>
        </div>

        <div class="timeline">
            <% eventos.forEach(function(item) { %>
                <div class="timeline-item">
                    <div class="timeline-marker"></div>
                    <div class="timeline-card">
                        <span class="timeline-ano"><%= item.ano %></span>
                        <h3 class="timeline-titulo"><%= item.evento %></h3>
                        
                        <% if (item.foto) { %>
                            <img src="<%= item.foto %>" alt="<%= item.evento %>" class="timeline-img">
                        <% } %>

                        <p class="timeline-descricao"><%= item.descricao %></p>
                    </div>
                </div>
            <% }); %>
        </div>
    </main>
    <%- include ('partials/footer.ejs') %>